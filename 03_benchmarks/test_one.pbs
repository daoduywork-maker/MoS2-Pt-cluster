#!/bin/bash
# Step 03 pre-test: relax ONE 6x6 job (Pt1_V1). Writes an early report to test_one.log after the
# first ionic step (memory, time per SCF and per ionic step), then a final report when done.
# run_all.pbs can be submitted once the early report looks fine; it leaves Pt1_V1 to this job.
# Submit from inside 03_benchmarks:   qsub test_one.pbs      then:  cat test_one.log
#PBS -N p2_test3
#PBS -q std40
#PBS -l nodes=1:ppn=40
#PBS -V
#PBS -l walltime=72:00:00
#PBS -j oe

module load intel/intel2020
module load vasp/vasp544elpa
export VASP_PP_PATH=/public/shared-data/pot/vasp/544/PAW_PBE

cd "$PBS_O_WORKDIR"
REPO=$(cd .. && pwd)
LOG="$PBS_O_WORKDIR/test_one.log"
d=Pt1_V1
cd $d
[ -f POTCAR ] || bash "$REPO/make_potcar.sh" > /dev/null || { echo "POTCAR FAILED" > "$LOG"; exit 1; }
bin=$(cat vasp_bin); command -v "$bin" > /dev/null || bin=vasp_std
echo "$(date '+%F %T')  started $d with $bin on $(hostname)" > "$LOG"
touch .running_test; trap 'rm -f .running_test' EXIT          # run_all.pbs skips this job while it runs
t0=$SECONDS
mpirun -np 40 -genv I_MPI_FABRICS=shm:ofi "$bin" > vasp.out 2>&1 &
pid=$!
# early report: as soon as the first ionic step is done
while kill -0 $pid 2>/dev/null; do
  if grep -q "LOOP+" OUTCAR 2>/dev/null; then
    {
      echo "$(date '+%F %T')  first ionic step done after $((SECONDS - t0)) s"
      echo "  SCF steps in step 1: $(awk '/^[A-Z]+ *: *[0-9]+/{n++} /F=/{print n; exit}' OSZICAR)"
      echo "  time per SCF step: $(grep 'LOOP:' OUTCAR | tail -3 | awk '{print $NF}' | tr '\n' ' ') s"
      echo "  memory so far: $(grep -i 'total amount of memory used' OUTCAR | tail -1)"
    } >> "$LOG"
    break
  fi
  sleep 60
done
wait $pid
{
  echo "$(date '+%F %T')  finished after $((SECONDS - t0)) s"
  echo "  ionic steps: $(grep -c 'F=' OSZICAR)"
  grep -q "reached required accuracy" OUTCAR && echo "  relaxation: reached required accuracy" || echo "  relaxation: NOT finished"
  grep -i "maximum memory used" OUTCAR
  tail -1 OSZICAR
} >> "$LOG"
