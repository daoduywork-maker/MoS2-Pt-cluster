#!/bin/bash
# Step 05 (plan B) on 2 fat96 nodes: 3 jobs per node at 32 cores each (6 at once), pinned to separate cores.
#   stage 1:  qsub run_all.pbs                    relaxes every job in screen/ (loose settings)
#   stage 2:  qsub -v STAGE=refine run_all.pbs    builds refine/<job> from screen/<job>/CONTCAR for each job
#                                                 named in refine_list.txt, and relaxes them with standard settings
# Finished jobs are skipped; a job cut off by the walltime restarts from its CONTCAR. Bash and awk only.
# Needs make_potcar.sh one level up.   Then:  cat run_all.log
#PBS -N p2_ptn
#PBS -q fat96
#PBS -l nodes=2:ppn=96
#PBS -V
#PBS -l walltime=240:00:00
#PBS -j oe

module load intel/intel2020
module load vasp/vasp544elpa
export VASP_PP_PATH=/public/shared-data/pot/vasp/544/PAW_PBE

cd "$PBS_O_WORKDIR"
REPO=$(cd .. && pwd)
STAGE=${STAGE:-screen}
LOG="$PBS_O_WORKDIR/run_all.log"
PER_NODE=3; NP=32
[ -f "$REPO/make_potcar.sh" ] || { echo "STOP: make_potcar.sh must sit next to 05_Ptn_small" | tee -a $LOG; exit 1; }

if [ "$STAGE" = refine ]; then
  [ -s refine_list.txt ] || { echo "STOP: refine_list.txt missing or empty" | tee -a $LOG; exit 1; }
  for j in $(grep -v '^#' refine_list.txt); do
    d=refine/$j; [ -d $d ] && continue
    [ -s screen/$j/CONTCAR ] || { echo "skip $j: no screen CONTCAR" >> $LOG; continue; }
    mkdir -p $d; cp screen/$j/CONTCAR $d/POSCAR; cp screen/$j/KPOINTS screen/$j/vasp_bin $d/
    [ -f screen/$j/POTCAR ] && cp screen/$j/POTCAR $d/
    sed -e 's/^PREC .*/PREC    = Accurate/' -e 's/^EDIFF .*/EDIFF   = 1E-5/' \
        -e 's/^EDIFFG .*/EDIFFG  = -0.02/' -e 's/^NSW .*/NSW     = 300/' screen/$j/INCAR > $d/INCAR
  done
fi

JOBS=$(find $STAGE -name INCAR | sed 's|/INCAR$||' | sort)
find $STAGE -name .claimed -type d -exec rmdir {} + 2>/dev/null
echo "=== $(date '+%F %T')  $STAGE  job $PBS_JOBID on: $(sort -u $PBS_NODEFILE | tr '\n' ' ')  ($(echo $JOBS | wc -w) jobs)" >> $LOG

worker() {
  local host=$1 pins=$2
  for d in $JOBS; do
    grep -q "General timing" "$d/OUTCAR" 2>/dev/null && continue
    mkdir "$d/.claimed" 2>/dev/null || continue
    (
      cd "$d" || exit 1
      [ -f POTCAR ] || bash "$REPO/make_potcar.sh" > /dev/null || { echo "$d  POTCAR FAILED" >> "$LOG"; exit 1; }
      if [ -s CONTCAR ] && [ -f OUTCAR ]; then
        [ -f POSCAR.orig ] || cp POSCAR POSCAR.orig
        cp CONTCAR POSCAR; echo "$d  restarting from CONTCAR" >> "$LOG"
      fi
      bin=$(cat vasp_bin); command -v "$bin" > /dev/null || bin=vasp_std
      t0=$SECONDS
      mpirun -np $NP -hosts $host -genv I_MPI_FABRICS=shm:ofi -genv I_MPI_PIN_PROCESSOR_LIST=$pins "$bin" > vasp.out 2>&1
      nelm=$(grep -E "^ *NELM *=" INCAR | awk -F= '{print $2+0}')
      steps=$(awk '/^[A-Z]+ *: *[0-9]+/{n++} /F=/{s=n; n=0} END{print s+0}' OSZICAR 2>/dev/null)
      nion=$(grep -c "F=" OSZICAR 2>/dev/null)
      if ! grep -q "General timing" OUTCAR 2>/dev/null; then st=FAILED
      elif [ "$steps" -ge "$nelm" ]; then st="UNCONVERGED($steps/$nelm)"
      elif ! grep -q "reached required accuracy" OUTCAR; then st="NOT_RELAXED($nion ionic)"
      else st="ok($nion ionic steps)"; fi
      mem=$(grep -i "maximum memory used" OUTCAR 2>/dev/null | awk '{printf "%.1f GB", $5/1048576}')
      e=$(awk '/F=/{for(i=1;i<=NF;i++) if($i=="E0=") e=$(i+1)} END{print e}' OSZICAR 2>/dev/null)
      x=$(grep "Edisp" OUTCAR 2>/dev/null | tail -1 | awk '{print $NF}')
      echo "$d  $host  $((SECONDS - t0)) s  mem=${mem:-n/a}  $st  E0=${e:-n/a}  Edisp=${x:-n/a}" >> "$LOG"
    )
    rmdir "$d/.claimed"
  done
}

for h in $(sort -u $PBS_NODEFILE); do
  for s in $(seq 0 $((PER_NODE - 1))); do
    worker "$h" "$((s * NP))-$((s * NP + NP - 1))" &
    sleep 5
  done
done
wait
echo "=== $(date '+%F %T')  $STAGE done" >> $LOG
