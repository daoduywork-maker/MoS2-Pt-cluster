#!/bin/bash
# Step 01: run all 40 convergence jobs one after another in a single PBS job.
# Submit from inside 01_convergence:   qsub run_all.pbs
# Finished jobs are skipped, so the script can be resubmitted after a failure.
# Modules and launch line follow the lab's Wuzhou templates (pbs_s40wz_vasp-std.sh).
#PBS -N p2_conv
#PBS -q std40
#PBS -l nodes=1:ppn=40
#PBS -V
#PBS -l walltime=06:00:00
#PBS -j oe

module load intel/intel2020
module load vasp/vasp544elpa

# PBE POTCAR directory: must be the folder that directly contains Mo_pv/ S/ Pt/
export VASP_PP_PATH=/public/shared_data/pot/vasp/544/PAW_PBE

cd "$PBS_O_WORKDIR"
REPO=$(cd .. && pwd)

# pre-flight checks: stop before running anything if the setup is wrong
for el in Mo_pv S Pt; do
  [ -f "$VASP_PP_PATH/$el/POTCAR" ] || { echo "STOP: $VASP_PP_PATH/$el/POTCAR not found" | tee run_all.log; exit 1; }
done
grep -q "PAW_PBE" "$VASP_PP_PATH/Pt/POTCAR" || { echo "STOP: $VASP_PP_PATH is not a PBE set" | tee run_all.log; exit 1; }
[ -f "$REPO/make_potcar.sh" ] || { echo "STOP: make_potcar.sh must sit next to 01_convergence" | tee run_all.log; exit 1; }

for d in $(find . -name INCAR | sed 's|/INCAR$||' | sort); do
  (
    cd "$d" || exit 1
    if grep -q "General timing" OUTCAR 2>/dev/null; then echo "$d  skipped (already finished)"; exit 0; fi
    [ -f POTCAR ] || bash "$REPO/make_potcar.sh" > /dev/null || { echo "$d  POTCAR FAILED"; exit 1; }
    nat=$(sed -n '7p' POSCAR | awk '{s=0; for(i=1;i<=NF;i++) s+=$i; print s}')
    np=40; [ "$nat" -le 3 ] && np=8                       # tiny cells: fewer MPI ranks
    bin=$(cat vasp_bin); command -v "$bin" > /dev/null || bin=vasp_std   # fall back if vasp_gam is absent
    t0=$SECONDS
    mpirun -np $np -genv I_MPI_FABRICS=shm:ofi "$bin" > vasp.out 2>&1
    if grep -q "General timing" OUTCAR 2>/dev/null; then st=ok; else st=FAILED; fi
    mem=$(grep "maximum memory used" OUTCAR 2>/dev/null | awk '{printf "%.1f GB", $5/1048576}')
    echo "$d  np=$np  $bin  $((SECONDS - t0)) s  mem=${mem:-n/a}  $st"
  )
done | tee run_all.log
